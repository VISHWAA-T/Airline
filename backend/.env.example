# Local development: uses localhost MongoDB
# PORT=5000
# MONGO_URI=mongodb://127.0.0.1:27017/airline_db
# JWT_SECRET=replace_with_a_strong_secret
# CORS_ORIGIN=http://localhost:5173

# Production (Render): use MongoDB Atlas
PORT=10000
MONGO_URI=mongodb+srv://username:password@cluster-name.mongodb.net/airline_db?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_secret_min_32_chars
CORS_ORIGIN=https://your-frontend-url.onrender.com
